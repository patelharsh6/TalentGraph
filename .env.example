# Copy to .env and fill in. All settings are read by src/talentgraph/config.py.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Storage (hostnames match docker-compose service names; use localhost when running natively) ---
DATABASE_URL=postgresql+asyncpg://talentgraph:talentgraph@postgres:5432/talentgraph
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- LLM (Google Gemini, free tier) ---
# Get a key at https://aistudio.google.com/apikey . Free-tier prompts may be used by Google to
# improve its products: only send synthetic or consented resumes.
GEMINI_API_KEY=
# real | fake | stub   (fake/stub never call the API; stub adds simulated latency for load tests)
LLM_MODE=real
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=8
# Attempts per call (429/5xx/timeouts are retried). Each attempt counts against the free-tier
# daily quota, so batch scripts run with 1.
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=4
LLM_STUB_LATENCY_MS=2500
# Gemini thinking level for structured extraction: low | medium | high (blank = model default; gemini-3.8-flash rejects minimal)
LLM_THINKING_LEVEL=low

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- API ---
# Key required in the X-API-Key header on write endpoints. Blank disables auth (local dev only).
API_KEY=
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
MAX_BATCH_FILES=20

# --- Parsing ---
# Redis parse cache TTL; keys are parse:{sha256(file)}:{PIPELINE_VERSION}
PARSE_CACHE_TTL_S=604800
# Section lexicon and other YAML config; taxonomy CSVs (used for rule-based skill candidates)
CONFIG_DIR=config
TAXONOMY_DIR=data/taxonomy

# --- Uploads ---
RETAIN_UPLOADS=false
UPLOAD_DIR=/app/uploads

# --- Docker compose host ports (compose interpolation only; not read by the app) ---
# Change these if the host already uses the port (e.g. another local Redis on 6379).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
