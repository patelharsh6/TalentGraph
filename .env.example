# Copy to .env and fill in. All settings are read by src/talentgraph/config.py.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Storage (hostnames match docker-compose service names; use localhost when running natively) ---
DATABASE_URL=postgresql+asyncpg://talentgraph:talentgraph@postgres:5432/talentgraph
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# --- LLM (Google Gemini, free tier) ---
# Get a key at https://aistudio.google.com/apikey . Free-tier prompts may be used by Google to
# improve its products: only send synthetic or consented resumes.
GEMINI_API_KEY=
# real | fake | stub   (fake/stub never call the API; stub adds simulated latency for load tests)
LLM_MODE=real
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=8
LLM_MAX_CONCURRENCY=4
# Set these to your free-tier limits shown at https://aistudio.google.com/rate-limit
LLM_RPM_LIMIT=10
LLM_RPD_LIMIT=250
LLM_STUB_LATENCY_MS=2500

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- API limits ---
MAX_UPLOAD_MB=10
MAX_BATCH_FILES=100
DEFAULT_RATE_LIMIT_PER_MIN=60
MAX_INFLIGHT_PER_KEY=50

# --- Webhooks / uploads ---
WEBHOOK_MAX_ATTEMPTS=5
RETAIN_UPLOADS=false
UPLOAD_DIR=/app/uploads

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
